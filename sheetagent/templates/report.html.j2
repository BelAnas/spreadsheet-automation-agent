<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} - {{ facts.period_label }}</title>
<style>
  :root { color-scheme: light; --page:#f4f3f0; --surface:#fcfcfb; --text:#0b0b0b; --muted:#52514e; --line:#e7e6e2; --accent:#2a78d6; --good:#0ca30c; --critical:#d03b3b; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { color-scheme: dark; --page:#111110; --surface:#1a1a19; --text:#f0efec; --muted:#c3c2b7; --line:#33332f; --accent:#3987e5; }
  }
  :root[data-theme="dark"] { color-scheme: dark; --page:#111110; --surface:#1a1a19; --text:#f0efec; --muted:#c3c2b7; --line:#33332f; --accent:#3987e5; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--page); color:var(--text); font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
  main { max-width:1080px; margin:0 auto; padding:32px 16px 64px; }
  header p, .muted { color:var(--muted); }
  h1 { font-size:26px; line-height:1.2; margin:0 0 4px; text-wrap:balance; }
  h2 { font-size:16px; margin:0 0 12px; }
  section, .card { background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:20px; margin-top:16px; }
  .summary p { font-size:16px; margin:0; max-width:75ch; }
  .tag { display:inline-block; margin-top:12px; font-size:12px; color:var(--muted); border:1px solid var(--line); border-radius:99px; padding:2px 10px; }
  .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-top:16px; }
  .tile { background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:14px 16px; }
  .tile .label { font-size:12px; color:var(--muted); }
  .tile .value { font-size:24px; font-weight:650; font-variant-numeric:tabular-nums; line-height:1.3; }
  .tile .delta { font-size:12px; color:var(--muted); }
  .grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:16px; }
  .grid2 > section { min-width:0; }
  .scroll { overflow-x:auto; }
  table { border-collapse:collapse; width:100%; font-size:14px; }
  th { text-align:left; font-weight:600; color:var(--muted); font-size:12px; border-bottom:1px solid var(--line); padding:6px 10px 6px 0; white-space:nowrap; }
  td { border-bottom:1px solid var(--line); padding:6px 10px 6px 0; vertical-align:top; }
  td.num, th.num { text-align:right; font-variant-numeric:tabular-nums; padding-right:0; padding-left:10px; }
  tr:last-child td { border-bottom:0; }
  .status { white-space:nowrap; padding-left:20px; }
  .dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; }
  ul { margin:0; padding-left:20px; }
  details { margin-top:12px; } summary { cursor:pointer; color:var(--muted); }
  footer { margin-top:24px; font-size:12px; color:var(--muted); }
</style>
</head>
<body>
<main>
<header>
  <h1>{{ title }}</h1>
  <p>{{ facts.period_label }} &middot; generated {{ generated }} &middot; {{ q.rows_used }} of {{ q.rows_read }} rows used</p>
</header>

<section class="summary">
  <h2>Summary</h2>
  <p>{{ summary.text }}</p>
  <span class="tag">Written by: {{ summary.source }}. Every number in it was checked against the figures below.</span>
</section>

<div class="tiles">
  {% for tile in tiles %}
  <div class="tile"><div class="label">{{ tile.label }}</div><div class="value">{{ tile.value }}</div>
    <div class="delta">{{ tile.note }}</div></div>
  {% endfor %}
</div>

<section>
  <h2>Revenue per day ({{ facts.currency }})</h2>
  <div id="chart-daily"></div>
</section>

<div class="grid2">
  <section>
    <h2>Revenue by region against target ({{ facts.currency }})</h2>
    <div id="chart-regions"></div>
  </section>
  <section>
    <h2>Revenue by category ({{ facts.currency }})</h2>
    <div id="chart-categories"></div>
  </section>
</div>

<section>
  <h2>Regions</h2>
  <div class="scroll"><table>
    <tr><th>Region</th><th class="num">Revenue</th><th class="num">Share</th><th class="num">Orders</th><th class="num">Target</th><th class="num">Of target</th><th class="status">Status</th><th class="num">Against last month</th></tr>
    {% for r in facts.regions %}
    <tr><td>{{ r.region }}</td><td class="num">{{ money(r.revenue) }}</td><td class="num">{{ pct(r.share_pct) }}</td>
      <td class="num">{{ r.orders }}</td><td class="num">{{ money(r.target) }}</td><td class="num">{{ pct(r.attainment_pct) }}</td>
      <td class="status">{% if r.attainment_pct is none %}-{% elif r.attainment_pct >= 100 %}<span class="dot" style="background:var(--good)"></span>&#10003; On target{% else %}<span class="dot" style="background:var(--critical)"></span>&#9660; Below target{% endif %}</td>
      <td class="num">{{ signed(r.change_pct) }}</td></tr>
    {% endfor %}
  </table></div>
</section>

<div class="grid2">
  <section>
    <h2>Categories</h2>
    <div class="scroll"><table>
      <tr><th>Category</th><th class="num">Revenue</th><th class="num">Share</th><th class="num">Margin</th></tr>
      {% for c in facts.categories %}
      <tr><td>{{ c.category }}</td><td class="num">{{ money(c.revenue) }}</td><td class="num">{{ pct(c.share_pct) }}</td><td class="num">{{ pct(c.margin_pct) }}</td></tr>
      {% endfor %}
    </table></div>
  </section>
  <section>
    <h2>Top products</h2>
    <div class="scroll"><table>
      <tr><th>Product</th><th>Code</th><th class="num">Revenue</th><th class="num">Units</th></tr>
      {% for p in facts.top_products %}
      <tr><td>{{ p.product_name or "-" }}</td><td>{{ p.sku }}</td><td class="num">{{ money(p.revenue) }}</td><td class="num">{{ "{:,.0f}".format(p.units) }}</td></tr>
      {% endfor %}
    </table></div>
  </section>
</div>

<section>
  <h2>Data quality</h2>
  <p class="muted" style="margin-top:0">{{ q.rows_read }} rows read, {{ q.rows_used }} used, {{ q.rows_rejected }} set aside. Nothing is dropped silently: each row left out is listed with its file, its row number and the reason.</p>
  {% if q.warnings %}<ul>{% for w in q.warnings %}<li>{{ w }}</li>{% endfor %}</ul>{% endif %}
  <div class="grid2" style="margin-top:12px">
    <div class="scroll"><table>
      <tr><th>Reason a row was set aside</th><th class="num">Rows</th></tr>
      {% for reason, n in q.rejected_by_reason.items() %}<tr><td>{{ reason }}</td><td class="num">{{ n }}</td></tr>{% endfor %}
      {% if not q.rejected_by_reason %}<tr><td>None</td><td class="num">0</td></tr>{% endif %}
    </table></div>
    <div class="scroll"><table>
      <tr><th>What the agent did</th><th>Detail</th></tr>
      {% for t in trace %}<tr><td style="white-space:nowrap">{{ t.step }}</td><td>{{ t.detail }}</td></tr>{% endfor %}
    </table></div>
  </div>
  <details><summary>How each column was read ({{ mappings|length }} columns)</summary>
    <div class="scroll"><table>
      <tr><th>File</th><th>Column</th><th>Read as</th><th>Method</th></tr>
      {% for m in mappings %}<tr><td>{{ m.source }}</td><td>{{ m.column }}</td><td>{{ m.field }}</td><td>{{ m.method }}</td></tr>{% endfor %}
    </table></div>
  </details>
  {% if rejected %}
  <details><summary>Rows set aside (first {{ rejected|length }} of {{ q.rows_rejected }}; the full list is in the Excel report)</summary>
    <div class="scroll"><table>
      <tr><th>File</th><th class="num">Row</th><th>Reason</th><th>Original content</th></tr>
      {% for r in rejected %}<tr><td>{{ r.source }}</td><td class="num">{{ r.row }}</td><td>{{ r.reason }}</td><td>{{ r.original }}</td></tr>{% endfor %}
    </table></div>
  </details>
  {% endif %}
</section>

<footer>Figures are computed from the cleaned rows by code. Model: {{ llm.provider }}{% if llm.provider != "mock" %} ({{ llm.model }}, {{ llm.calls }} calls){% endif %}. Built in {{ "%.1f"|format(seconds) }} s.</footer>
</main>
{{ plotly_script|safe }}
<script>
  const FIGURES = {{ figures_json|safe }};
  const dark = window.matchMedia("(prefers-color-scheme: dark)");
  function draw() {
    const forced = document.documentElement.dataset.theme;
    const theme = forced || (dark.matches ? "dark" : "light");
    for (const name of ["daily", "regions", "categories"]) {
      const fig = FIGURES[theme][name];
      Plotly.react("chart-" + name, fig.data, fig.layout, {displayModeBar: false, responsive: true});
    }
  }
  if (window.Plotly) { draw(); dark.addEventListener("change", draw); }
  else { for (const el of document.querySelectorAll("[id^=chart-]")) el.textContent = "Charts need an internet connection in this version of the report; the tables below hold the same figures."; }
</script>
</body>
</html>
